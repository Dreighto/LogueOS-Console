{
  "_meta": "Workspace-tier MCP config for LogueOS-Console. Gemini CLI discovers this when CWD is anywhere inside this repo (including the /home/dreighto/dev/worktrees/LogueOS-Console/w* worktrees). 'logueos-gateway' is the SOLE audited-writes path — workers go through the LogueOS-Orchestrator MCP gateway for git/linear/docs/notion, gated per the X-LogueOS-Tool-Profile header injected at spawn time. Other servers are READ-ONLY frontend toolkit + local test runners.",
  "mcpServers": {
    "logueos-gateway": {
      "httpUrl": "http://127.0.0.1:18766/mcp",
      "headers": {
        "X-LogueOS-Tool-Profile": "${env:LOGUEOS_TOOL_PROFILE}",
        "X-LogueOS-Trace-Id": "${env:LOGUEOS_TRACE_ID}"
      },
      "trust": true,
      "timeout": 600000
    },
    "svelte": {
      "command": "npx",
      "args": ["-y", "@sveltejs/mcp"],
      "env": {},
      "trust": false
    },
    "shadcn-svelte": {
      "command": "npx",
      "args": ["-y", "@jpisnice/shadcn-ui-mcp-server", "--framework", "svelte"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${env:GITHUB_TOKEN}"
      },
      "trust": false
    },
    "lucide-icons": {
      "command": "npx",
      "args": ["-y", "lucide-icons-mcp"],
      "env": {},
      "trust": false
    },
    "a11y-scanner": {
      "command": "npx",
      "args": ["-y", "mcp-accessibility-scanner"],
      "env": {},
      "trust": false
    },
    "vitest": {
      "command": "npx",
      "args": ["-y", "@djankies/vitest-mcp"],
      "env": {},
      "trust": false
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp", "--isolated"],
      "env": {},
      "trust": false
    },
    "sequential-thinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"],
      "env": {},
      "trust": false
    }
  }
}
